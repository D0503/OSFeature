        "assets": "routes/float-view.md",
        "validation": "routes/float-view.md"
      }
    },
    {
      "id": "floating-ball",
      "displayName": "闪控球",
      "minApi": 20,
      "requiresStage": true,
      "moduleTypes": [
        "entry",
        "feature"
      ],
      "components": [
        "floatingBall"
      ],
      "documents": {
        "implementation": "routes/floating-ball.md",
        "assets": "routes/floating-ball.md",
        "validation": "routes/floating-ball.md"
