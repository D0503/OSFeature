    {
      "id": "IL-F021",
      "category": "compatibility",
      "normativeStatus": "clear",
      "statement": "compatible API 低于 26 时应使用版本条件保留原普通样式分支，不能在低版本路径引用 API 26 能力。",
      "sources": [{"snapshotId":"compatibility","locator":"L7,L67-L71","sha256":"c1de0cc670559c0c67b6196d378ab8d87d2594e6af2546aa65776f8e2f5381fe"}],
