      "category": "material-option",
      "normativeStatus": "clear",
      "statement": "applyShadow 与普通 shadow 属性存在顺序和所有权约束，避免重复阴影。",
      "sources": [{"snapshotId":"common","locator":"L202","sha256":"8750a14c14240054ee597e7f389da6d78f1530a27e7f1cc8ef142ffc41d23457"},{"snapshotId":"constraints","locator":"L215","sha256":"76d6de2d678f4b582a2f29b9811e1342ee895dc99fcc1c84dd20f1d881872fa7"}],
