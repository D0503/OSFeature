    {
      "id": "IL-F014",
      "category": "control",
      "normativeStatus": "clear",
      "statement": "Button、Select、Toggle、Slider、ChipGroup 和 SegmentButton 系列提供组件或样式级材质入口。",
      "sources": [{"snapshotId":"component","locator":"L112-L190","sha256":"5b610a4e5158c841b53662fa45e7325c5ef9db3239c4cef0b2ce61b125c46d8a"}],
      "validationKinds": ["static", "sdk", "build", "runtime", "visual"]
    },
    {
      "id": "IL-F015",
      "category": "control",
      "normativeStatus": "clear",
      "statement": "Select 按钮和下拉菜单是两个独立入口，分别使用 systemMaterial 与 menuSystemMaterial。",
      "sources": [{"snapshotId":"component","locator":"L126-L133","sha256":"5b610a4e5158c841b53662fa45e7325c5ef9db3239c4cef0b2ce61b125c46d8a"}],
      "validationKinds": ["static", "sdk", "build", "runtime", "visual"]
