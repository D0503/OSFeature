{
  "schemaVersion": "1.0",
  "featureId": "immersive-light",
  "scenarios": [
    {
      "id": "IL-S001",
      "displayName": "应用级 default、enable、disable 状态验证",
      "intentPatterns": ["应用级", "全局", "default", "enable", "disable", "开启后关闭", "应用开关", "metadata"],
      "targets": ["entry/module.json5"],
      "factRefs": ["IL-F002", "IL-F003", "IL-F006", "IL-F007", "IL-F008"],
      "implementation": {
        "assets": ["assets/ApplicationMaterialMetadata.json5", "assets/ImmersiveMaterialProbe.ets"],
        "steps": [
          "在用户确认的 entry 模块 module.json5 中只修改 module.metadata。",
          "目标工程只保留用户要求的最终 default、enable 或 disable 状态。",
          "default/enable/disable 对照变体放入临时最小工程或临时副本，不连续覆盖目标工程。",
          "用同一组件的显式 ImmersiveMaterial 作为 disable 作用域探针。"
        ]
      },
      "staticRules": [
        {"id":"metadata-name","kind":"require_any","patterns":["ohos\\.arkui\\.UIMaterial\\.state"],"onMissing":"failed","message":"entry 模块必须包含正确的 metadata 名称。"},
        {"id":"metadata-value","kind":"require_any","patterns":["value\\s*:\\s*['\"](?:default|enable|disable)['\"]"],"onMissing":"failed","message":"metadata 值必须是 default、enable 或 disable。"},
        {"id":"entry-only","kind":"module_metadata_entry_only","onViolation":"failed","message":"应用级材质 metadata 只能配置在 entry 模块。"}
      ],
      "negativeCases": ["不配置 metadata", "在非 entry 模块配置", "disable 下组件显式 ImmersiveMaterial", "Material.empty 与 undefined 切换"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "alternatives",
      "expectedOutcomes": [
        {"id":"IL-O001-A","factRefs":["IL-F006"],"assertion":"应用级 disable 后，应用级默认和组件级显式材质均不显示。"},
        {"id":"IL-O001-B","factRefs":["IL-F007"],"assertion":"应用级 disable 后，应用级默认材质不显示，但组件级显式材质仍显示。"}
      ]
    },
    {
      "id": "IL-S002",
      "displayName": "组件级开启、关闭与恢复",
      "intentPatterns": ["组件级", "组件开启", "组件关闭", "恢复默认", "Material.empty", "undefined", "关闭沉浸光感"],
      "targets": ["common component"],
      "factRefs": ["IL-F004", "IL-F005", "IL-F008", "IL-F022", "IL-F026"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialFactory.ets"],
        "steps": [
          "保持组件树、状态、事件和普通样式基线不变，只增加 systemMaterial 值来源。",
          "开启使用 ImmersiveMaterial，关闭使用 Material.empty，恢复使用 undefined。",
          "低版本或设备不支持时回到接入前普通样式。"
        ]
      },
      "staticRules": [
        {"id":"component-entry","kind":"require_any","patterns":["\\bsystemMaterial\\s*\\("],"onMissing":"failed","message":"未发现组件级 systemMaterial 入口。"},
        {"id":"empty-state","kind":"require_any","patterns":["Material\\.empty"],"onMissing":"inconclusive","message":"关闭场景未发现 Material.empty。"},
        {"id":"support-guard","kind":"require_any","patterns":["isImmersiveMaterialSupported\\s*\\("],"onMissing":"failed","message":"缺少设备能力查询。"}
      ],
      "negativeCases": ["设备不支持", "API 26 以下", "从 Material.empty 恢复为 undefined", "保留普通背景与事件"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O002","factRefs":["IL-F004","IL-F005","IL-F022","IL-F026"],"assertion":"补齐目标工程上下文后，开启、关闭、恢复和不支持分支均保持原交互，视觉状态与各自规范相符。"}]
    },
    {
      "id": "IL-S003",
      "displayName": "Navigation、Tabs 与 AlphabetIndexer 接入",
      "intentPatterns": ["Navigation", "NavDestination", "Tabs", "TabContent", "AlphabetIndexer", "导航", "页签", "索引器"],
      "targets": ["Navigation", "NavDestination", "Tabs", "AlphabetIndexer"],
      "factRefs": ["IL-F009", "IL-F010", "IL-F011", "IL-F022"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialFactory.ets"],
        "steps": [
          "先识别目标到底是标题栏、悬浮 TabBar 或索引器弹窗，使用对应 Options/Style 入口。",
          "Tabs 只修改 FloatingTabBarStyle.systemMaterial，不向 TabContent 错加材质。",
          "清除与目标材质同层互斥的背景色和背景模糊；不删除其他层的设计背景。"
        ]
      },
      "staticRules": [
        {"id":"navigation-entry","kind":"require_any","patterns":["NavigationTitleOptions", "FloatingTabBarStyle", "barFloatingStyle", "AlphabetIndexer"],"onMissing":"failed","message":"未发现目标导航组件入口。"},
        {"id":"tabs-material","kind":"conditional_require","when":"barFloatingStyle|FloatingTabBarStyle","patterns":["systemMaterial"],"onMissing":"failed","message":"FloatingTabBarStyle 缺少 systemMaterial。"},
        {"id":"tabs-background-conflict","kind":"forbid_pair","left":"(?:barFloatingStyle|FloatingTabBarStyle)[\\s\\S]{0,800}systemMaterial","right":"barBackground(?:Color|BlurStyle)","onViolation":"inconclusive","message":"Tabs 栏普通背景可能覆盖材质，需核对同一配置对象。"},
        {"id":"indexer-background-conflict","kind":"forbid_pair","left":"AlphabetIndexer[\\s\\S]{0,1200}systemMaterial","right":"popupBackground(?:BlurStyle)?","onViolation":"inconclusive","message":"AlphabetIndexer 弹窗背景可能覆盖材质。"}
      ],
      "negativeCases": ["Tabs 同时配置栏背景色", "AlphabetIndexer 同时配置弹窗背景或模糊", "undefined 恢复默认", "设备不支持"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O003","factRefs":["IL-F009","IL-F010","IL-F011"],"assertion":"目标导航区域显示预期材质，普通背景不覆盖，布局、滚动和切换行为不回归。"}]
    },
    {
      "id": "IL-S004",
      "displayName": "Toast、Popup、Tips、Menu、Dialog、Sheet 接入",
      "intentPatterns": ["Toast", "Popup", "Tips", "Menu", "Dialog", "Sheet", "弹窗", "提示", "菜单", "对话框", "半模态"],
      "targets": ["Toast", "Popup", "Tips", "Menu", "Dialog", "Sheet"],
      "factRefs": ["IL-F012", "IL-F013", "IL-F017", "IL-F022", "IL-F023"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialFactory.ets"],
        "steps": [
          "先确定具体弹窗 API 和 Options 类型，使用该 API 声明的 systemMaterial 字段。",
          "只在目标弹窗配置对象中加入材质，不把一种 Options 类型强转复用于其他弹窗。",
          "保留打开、关闭、取消、回调和错误处理；检查普通背景、模糊、面积与透明色冲突。"
        ]
      },
      "staticRules": [
        {"id":"overlay-target","kind":"require_any","patterns":["showToast", "bindPopup", "bindTips", "bindMenu", "showDialog", "bindSheet"],"onMissing":"failed","message":"未发现受支持的弹窗调用。"},
        {"id":"overlay-material","kind":"require_any","patterns":["systemMaterial\\s*:"],"onMissing":"failed","message":"目标弹窗 Options 中缺少 systemMaterial。"},
        {"id":"overlay-background-conflict","kind":"forbid_pair","left":"systemMaterial\\s*:","right":"background(?:Color|BlurStyle)\\s*:","onViolation":"inconclusive","message":"同文件发现普通背景与材质，需确认是否位于同一弹窗 Options。"}
      ],
      "negativeCases": ["普通背景覆盖", "不透明 materialColor", "超大 Dialog/Sheet", "取消与关闭回调", "设备不支持"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O004","factRefs":["IL-F012","IL-F013"],"assertion":"指定弹窗可正常打开关闭，目标区域材质可见且无背景覆盖、尺寸异常或回调回归。"}]
    },
    {
      "id": "IL-S005",
      "displayName": "Button、Select、Toggle、Slider、ChipGroup、SegmentButton 接入",
      "intentPatterns": ["Button", "Select", "Toggle", "Slider", "ChipGroup", "SegmentButton", "按钮", "选择器", "开关", "滑块", "胶囊"],
      "targets": ["Button", "Select", "Toggle", "Slider", "ChipGroup", "SegmentButton", "SegmentButtonV2"],
      "factRefs": ["IL-F014", "IL-F015", "IL-F016", "IL-F019", "IL-F022"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialFactory.ets"],
        "steps": [
          "使用目标组件声明的 systemMaterial 或样式字段，不假定所有组件参数形状相同。",
          "Select 的按钮和菜单分别决定是否接入；Toggle Checkbox 不接入并保留普通样式。",
          "开启 interactive 或 lightEffect 后复测点击、长按、悬停、拖动和禁用态。"
        ]
      },
      "staticRules": [
        {"id":"control-target","kind":"require_any","patterns":["\\b(?:Button|Select|Toggle|Slider|ChipGroup|SegmentButtonV?2?)\\s*\\("],"onMissing":"failed","message":"未发现受支持的目标控件。"},
        {"id":"control-material","kind":"require_any","patterns":["systemMaterial", "menuSystemMaterial"],"onMissing":"failed","message":"未发现控件材质入口。"},
        {"id":"select-dual-entry","kind":"conditional_require","when":"\\bSelect\\s*\\(","patterns":["systemMaterial", "menuSystemMaterial"],"onMissing":"inconclusive","message":"Select 的按钮与菜单是否都需接入尚未完整表达。"},
        {"id":"checkbox-unsupported","kind":"forbid_pair","left":"ToggleType\\.Checkbox","right":"systemMaterial","onViolation":"failed","message":"Toggle Checkbox 不在首版支持范围。"}
      ],
      "negativeCases": ["Select 只接按钮或只接菜单", "Toggle Checkbox", "禁用态", "交互与流光覆盖旧反馈", "设备不支持"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O005","factRefs":["IL-F014","IL-F015","IL-F016","IL-F019"],"assertion":"目标控件材质、状态和交互符合其专用契约，未支持形态保持普通样式。"}]
    },
    {
      "id": "IL-S006",
      "displayName": "materialColor、反色、交互、光效和阴影参数",
      "intentPatterns": ["materialColor", "colorInvert", "反色", "interactive", "lightEffect", "光效", "流光", "applyShadow", "阴影", "透明度"],
      "targets": ["ImmersiveOptions", "ImmersiveMaterial"],
      "factRefs": ["IL-F017", "IL-F018", "IL-F019", "IL-F020", "IL-F025"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialFactory.ets"],
        "steps": [
          "只设置开发目标要求的材质参数，其他字段保持 undefined 或原状态。",
          "materialColor 使用带透明度的资源色或 ARGB 值；反色目标优先使用资源颜色。",
          "applyShadow 与普通 shadow 只保留一个所有者，并按目标 API 的属性顺序检查。"
        ]
      },
      "staticRules": [
        {"id":"material-construction","kind":"require_any","patterns":["new\\s+uiMaterial\\.ImmersiveMaterial", "ImmersiveMaterialFactory"],"onMissing":"failed","message":"未发现材质参数构造。"},
        {"id":"opaque-color","kind":"forbid","pattern":"materialColor\\s*:\\s*(?:Color\\.(?:Black|White|Red|Green|Blue)|['\"]#[0-9a-fA-F]{6}['\"])","onViolation":"inconclusive","message":"materialColor 疑似不透明，可能完全遮挡滤镜。"},
        {"id":"hardcoded-color-invert","kind":"forbid_pair","left":"colorInvert","right":"#[0-9a-fA-F]{6,8}","onViolation":"inconclusive","message":"反色与硬编码颜色并存，不能证明硬编码颜色会反色。"},
        {"id":"duplicate-shadow","kind":"forbid_pair","left":"applyShadow\\s*:\\s*true","right":"\\.shadow\\s*\\(","onViolation":"inconclusive","message":"系统阴影与普通 shadow 可能重复。"}
      ],
      "negativeCases": ["完全不透明 materialColor", "硬编码颜色反色", "interactive false/null", "lightEffect undefined/null", "重复阴影"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O006","factRefs":["IL-F017","IL-F018","IL-F019","IL-F020","IL-F025"],"assertion":"不直接照搬疑似不透明示例；材质透明度、反色、交互、流光与阴影分别可观察且未互相覆盖。"}]
    },
    {
      "id": "IL-S007",
      "displayName": "API 26 以下与设备不支持时回退",
      "intentPatterns": ["API 26 以下", "低版本", "兼容", "回退", "降级", "设备不支持", "compatibleSdkVersion", "sdkApiVersion"],
      "targets": ["version branch", "fallback style"],
      "factRefs": ["IL-F001", "IL-F008", "IL-F021", "IL-F022"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialFactory.ets"],
        "steps": [
          "compile/target API 保持 26 或以上；compatible API 可低于 26。",
          "在 API 26 版本分支内使用沉浸材质，分支外完整保留接入前普通组件树或样式。",
          "在 API 26 设备上再用 isImmersiveMaterialSupported 区分设备能力。"
        ]
      },
      "staticRules": [
        {"id":"api-guard","kind":"require_any","patterns":["sdkApiVersion\\s*>=\\s*26", "apiVersion\\s*>=\\s*26"],"onMissing":"failed","message":"compatible API 低于 26 时缺少整树版本分支。"},
        {"id":"support-guard","kind":"require_any","patterns":["isImmersiveMaterialSupported\\s*\\("],"onMissing":"failed","message":"缺少设备能力查询。"},
        {"id":"fallback-style","kind":"manual","result":"inconclusive","message":"静态扫描不能证明低版本分支完整保留接入前布局、状态、事件和普通样式，需 diff 与运行证据。"}
      ],
      "negativeCases": ["compatible API 25", "设备能力返回 false", "普通样式仍可交互", "恢复路径"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O007","factRefs":["IL-F021","IL-F022"],"assertion":"API 26 或能力不满足时不调用材质路径，原组件结构、样式和交互完整可用。"}]
    },
    {
      "id": "IL-S008",
      "displayName": "性能约束与无效果故障诊断",
      "intentPatterns": ["性能", "功耗", "卡顿", "无效果", "不生效", "白屏", "故障", "诊断", "面积", "嵌套", "模糊叠加", "动态背景"],
      "targets": ["material regions", "runtime diagnostics"],
      "factRefs": ["IL-F008", "IL-F017", "IL-F020", "IL-F023", "IL-F024"],
      "implementation": {
        "assets": ["assets/ImmersiveMaterialProbe.ets"],
        "steps": [
          "先记录设备支持状态和全局材质档位，再定位目标材质区域。",
          "逐项排除普通背景覆盖、不透明材质色、属性顺序、嵌套、模糊叠加、动态背景和重复阴影。",
          "性能与功耗只在真机、固定场景、固定时长和对照基线下给出结论。"
        ]
      },
      "staticRules": [
        {"id":"diagnostic-probe","kind":"require_any","patterns":["isImmersiveMaterialSupported", "getGlobalMaterialLevel"],"onMissing":"inconclusive","message":"缺少运行能力与档位诊断信息。"},
        {"id":"nested-material","kind":"manual","result":"inconclusive","message":"需根据组件树确认材质是否嵌套。"},
        {"id":"blur-stacking","kind":"forbid_pair","left":"systemMaterial","right":"backgroundBlurStyle|foregroundBlurStyle","onViolation":"inconclusive","message":"材质与普通模糊可能叠加。"},
        {"id":"performance-device-only","kind":"manual","result":"inconclusive","message":"性能与功耗结论必须来自真机测量。"}
      ],
      "negativeCases": ["大面积材质", "嵌套材质", "模糊叠加", "动态背景", "大范围反色", "重复阴影"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"],
      "expectationMode": "all",
      "expectedOutcomes": [{"id":"IL-O008","factRefs":["IL-F023","IL-F024"],"assertion":"故障原因可由证据定位；性能和功耗相对基线无不可接受退化。"}]
    }
  ]
}
