{
  "schemaVersion": "1.0",
  "featureId": "smart-reach",
  "displayName": "智感握姿",
  "routeComposition": {
    "mode": "composable",
    "selectionField": "selectedRoutes",
    "allowed": ["native-component", "operating-hand", "holding-hand"]
  },
  "targetSdkPolicy": "preserve-unless-declared",
  "fallbackPolicy": {
    "baseline": "pre-integration-source-state",
    "appliesWhen": ["runtime-version-unsupported", "device-capability-unsupported", "permission-error", "feature-disabled", "service-or-subscription-failed"],
    "preserve": ["component-tree-or-existing-code-path", "responsive-layout-orientation-and-window-mode", "state-data-controllers-events-and-lifecycle", "existing-error-denial-and-unavailable-behavior", "ordinary-visual-style", "ongoing-interaction-and-original-position"]
  },
  "routes": [
    {
      "id": "native-component",
      "displayName": "系统组件原生适配（如 HDS）",
      "minApi": 23,
      "minApiMeaning": "verified-hdstabs-handedness-capability",
      "requiresStage": true,
      "moduleTypes": ["entry", "feature"],
      "components": ["HdsTabs"],
      "documents": { "implementation": "routes/native-component/implementation.md", "assets": "routes/native-component/assets.md", "validation": "routes/native-component/validation.md" }
    },
    {
      "id": "operating-hand",
      "displayName": "操作手感知",
      "minApi": 15,
      "minApiMeaning": "operating-hand-motion-api",
      "requiresStage": true,
      "moduleTypes": ["entry", "feature"],
      "components": ["motion.operatingHandChanged", "motion.getRecentOperatingHandStatus"],
      "documents": { "implementation": "routes/operating-hand/implementation.md", "assets": "routes/operating-hand/assets.md", "validation": "routes/operating-hand/validation.md" }
    },
    {
      "id": "holding-hand",
      "displayName": "握持手感知",
      "minApi": 20,
      "minApiMeaning": "holding-hand-motion-api",
      "requiresStage": true,
      "moduleTypes": ["entry", "feature"],
      "components": ["motion.holdingHandChanged"],
      "documents": { "implementation": "routes/holding-hand/implementation.md", "assets": "routes/holding-hand/assets.md", "validation": "routes/holding-hand/validation.md" }
    }
  ],
  "constraints": [
    { "id": "signal-ownership", "route": "all", "action": "one-position-owner-per-target" },
    { "id": "permission-version", "route": "operating-hand", "action": "activity-motion-api15-19-either-permission-api20-plus" },
    { "id": "holding-permission", "route": "holding-hand", "action": "detect-gesture-required" },
    { "id": "runtime-capability", "route": "all", "action": "sdk-and-syscap-do-not-prove-device-support" },
    { "id": "callback-lifecycle", "route": "all", "action": "custom-subscriptions-use-owned-callback-visible-lifecycle-and-success-flag" },
    { "id": "interaction-preservation", "route": "all", "action": "do-not-move-active-touch-target" }
  ],
  "documents": {
    "entry": "README.md",
    "compatibility": "compatibility.md",
    "implementation": "implementation.md",
    "validation": "performance-validation.md",
    "assets": "assets-catalog.md",
    "fallback": "fallback.md",
    "sharedValidation": "performance-validation.md",
    "troubleshooting": "troubleshooting.md"
  },
  "evidence": {
    "policy": "snapshot-first-verify-on-change-or-conflict"
  }
}
