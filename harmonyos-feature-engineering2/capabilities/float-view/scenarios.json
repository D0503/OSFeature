{
  "schemaVersion": "1.0",
  "featureId": "float-view",
  "displayName": "闪控窗与闪控球",
  "defaultRoute": "float-view-api26",
  "routes": [
    {
      "id": "float-view-api26",
      "displayName": "闪控窗（API 26）",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 26,
        "minTargetApi": 26,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "闪控窗接口、权限、模板和设备范围以本次冻结官网为准；不得仅根据能力名称推断兼容版本。"
      },
      "sdk": { "preferredApi": 26, "validatedLocalVersion": null, "requiredDeclarationGlobs": ["openharmony/ets/api/@ohos.window.floatView.d.ts"], "requiredSymbols": ["FloatViewController", "isFloatViewEnabled", "getFloatViewLimits", "setFloatViewVisibilityInApp"] },
      "supportedTargets": { "window": ["floatView", "FloatViewController"], "configuration": ["FloatViewConfiguration"] },
      "intentPatterns": ["闪控窗", "floatView", "float view", "API 26"]
    },
    {
      "id": "floating-ball-api20",
      "displayName": "闪控球（API 20 起）",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 20,
        "minTargetApi": 20,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "闪控球基础接口和后续版本新增接口分别以本次冻结官网为准。"
      },
      "sdk": { "preferredApi": 20, "validatedLocalVersion": null, "requiredDeclarationGlobs": ["openharmony/ets/api/@ohos.window.floatingBall.d.ts"], "requiredSymbols": ["FloatingBallController", "startFloatingBall", "updateFloatingBall", "stopFloatingBall"] },
      "supportedTargets": { "window": ["floatingBall", "FloatingBallController"], "configuration": ["FloatingBallParams"] },
      "intentPatterns": ["闪控球", "floatingBall", "floating ball", "API 20"]
    }
  ],
  "projectSignals": [
    { "id": "float-view-api", "route": "float-view-api26", "extensions": [".ets", ".ts"], "pattern": "\\bfloatView\\.|FloatViewController" },
    { "id": "floating-ball-api", "route": "floating-ball-api20", "extensions": [".ets", ".ts"], "pattern": "\\bfloatingBall\\.|FloatingBallController" },
    { "id": "float-view-permission", "extensions": [".json", ".json5", ".ets", ".ts"], "pattern": "ohos\\.permission\\.(FLOAT_VIEW|USE_FLOAT_BALL)" },
    { "id": "anti-peep", "extensions": [".ets", ".ts", ".json", ".json5"], "pattern": "dlpAntiPeep|DLP_GET_HIDE_STATUS|setAntiPeepMaskLayer" }
  ],
  "safety": {
    "modifyMinimumScope": true,
    "preserveDirtyFiles": true,
    "keepFailedChanges": true,
    "automaticRollback": false,
    "automaticSdkUpgrade": false,
    "automaticEmulatorDownload": false,
    "automaticUninstall": false,
    "maxDirectedRepairRounds": 2
  },
  "verification": {
    "layerStatuses": ["passed", "failed", "blocked", "not_run", "inconclusive"],
    "verdicts": ["passed", "passed_with_spec_conflict", "build_passed_runtime_pending", "inconclusive", "failed", "blocked"],
    "visualSuccessRequiresObservation": true,
    "buildCommand": "devecocli build",
    "runCommand": "devecocli run",
    "devicePolicy": "run-only-when-requested-and-exactly-one-device-selected"
  },
  "entryPoints": [
    { "snapshotId": "float-view-guide", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/doccenter-capabilities/float-view-guide", "title": "闪控窗开发指导" },
