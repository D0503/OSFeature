    { "snapshotId": "standby-form", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkui-ui-standby-form-development", "title": "待机屏保卡片开发指导" },
    { "snapshotId": "service-widget-design", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/design-guides/system-features-service-widget-0000002087671904", "title": "服务卡片设计指南" },
    { "snapshotId": "formkit-overview", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/formkit-overview", "title": "Form Kit 简介" },
    { "snapshotId": "push-form-update", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/push-form-update", "title": "推送卡片刷新消息" },
    { "snapshotId": "window-errors", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/errorcode-window", "title": "窗口错误码" },
    { "snapshotId": "universal-errors", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/errorcode-universal", "title": "通用错误码" }
  ],
  "scenarios": [
    {
      "id": "FV-S001",
      "displayName": "闪控窗基础创建、启动与停止",
      "route": "float-view-api26",
      "intentPatterns": ["创建闪控窗", "启动闪控窗", "停止闪控窗", "单独操作闪控窗", "isFloatViewEnabled", "floatView.create", "FLOAT_VIEW权限"],
      "intentGroups": [["闪控窗", "基础接入"], ["闪控窗", "权限"]],
      "targets": ["floatView", "FloatViewController"],
      "sources": ["float-view-guide", "float-view-api", "declare-permissions", "request-authorization", "window-errors", "universal-errors"],
      "criteriaSpec": {
        "required": [
          { "topic": "设备能力检查", "hint": "核对系统能力、设备支持接口和不支持时的降级。", "mustResolve": true },
          { "topic": "权限声明与授权", "hint": "核对权限类型、声明位置、用户授权流程和拒绝处理。", "mustResolve": true },
          { "topic": "控制器创建与内容设置", "hint": "核对创建配置、上下文要求和页面内容设置顺序。", "mustResolve": true },
          { "topic": "前台启动与单实例约束", "hint": "核对启动时应用状态、数量限制和冲突窗口条件。", "mustResolve": true },
          { "topic": "停止与失败处理", "hint": "核对主动停止、系统停止、异常返回和控制器清理。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "具备权限且设备支持时从前台启动唯一闪控窗，停止或系统销毁后释放控制器；不满足条件时安全降级。", "criteriaTopics": ["设备能力检查", "权限声明与授权", "控制器创建与内容设置", "前台启动与单实例约束", "停止与失败处理"] }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": ["闪控球绑定", "防窥保护", "锁屏卡片", "待机屏保"],
          "excludedCriterionTypes": ["version", "capability", "performance"],
          "includeExcludedTypeWhenPromptContains": {
            "version": ["API", "SDK", "版本"],
            "capability": ["设备", "机型", "支持范围"],
            "performance": ["性能", "功耗", "刷新频率"]
          }
        },
        "points": [
          {
            "id": "D01-01",
            "title": "闪控窗启动与停止",
            "execution": "single_page",
            "criteriaTopics": ["控制器创建与内容设置", "前台启动与单实例约束", "停止与失败处理"],
            "demoSetupRequirements": [
              { "id": "permission-granted", "description": "由用户完成闪控窗权限授权并确认设备支持。", "enforcement": "implementation_and_static_gate", "countsAsFeatureValidation": false }
            ],
            "interactionRequirements": [
              { "id": "start-float-view", "description": "从应用前台入口启动闪控窗。", "expected": "出现目标内容的闪控窗并收到本次判据要求的运行状态。" },
              { "id": "stop-float-view", "description": "从应用或闪控窗入口停止窗口。", "expected": "窗口消失且控制器进入可安全重建状态。" }
            ],
            "variants": [
              { "id": "stopped", "label": "未启动基线", "parameters": { "state": "stopped" } },
              { "id": "started", "label": "已启动闪控窗", "parameters": { "state": "started" } }
            ]
          }
        ]
      },
      "implementation": { "steps": ["先检查能力和权限，不在拒绝后循环申请。", "按本次判据建立控制器、内容和尺寸后启动。", "停止和系统销毁路径统一清理监听与控制器引用。"] },
      "staticRules": [
        { "id": "float-view-capability", "kind": "require_any", "patterns": ["isFloatViewEnabled\\s*\\(", "canIUse\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗设备能力检查。" },
        { "id": "float-view-create", "kind": "require_any", "patterns": ["floatView\\.create\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗控制器创建。" },
        { "id": "float-view-content", "kind": "require_any", "patterns": ["setUIContext(?:ByName)?\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗内容设置。" },
        { "id": "float-view-start", "kind": "require_any", "patterns": ["\\.start\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗启动调用。" },
        { "id": "float-view-stop", "kind": "require_any", "patterns": ["\\.stop\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗停止调用。" }
      ],
      "negativeCases": ["未经用户授权直接启动", "设备不支持时仍创建窗口", "并发创建多个闪控窗", "停止失败后无状态记录"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"]
    },
    {
      "id": "FV-S002",
      "displayName": "闪控窗模板、尺寸与动态适配",
      "route": "float-view-api26",
      "intentPatterns": ["闪控窗模板", "FloatViewTemplateType", "闪控窗尺寸", "getFloatViewLimits", "setWindowSize", "onLimitsChange", "onRectChange", "Mini态", "宽高比"],
      "intentPriority": 2,
      "targets": ["FloatViewTemplateType", "FloatViewLimits"],
      "sources": ["float-view-guide", "float-view-design", "float-view-api"],
      "criteriaSpec": {
        "required": [
          { "topic": "模板选择与内容结构", "hint": "核对目标交互对应的模板类型、标题栏和内容区结构。", "mustResolve": true },
          { "topic": "尺寸与宽高比限制", "hint": "核对当前模板和设备返回的最小、最大尺寸与比例范围。", "mustResolve": true },
          { "topic": "限制变化监听", "hint": "核对设备形态或系统条件变化后的限制更新与重算。", "mustResolve": true },
          { "topic": "实际矩形反馈", "hint": "核对系统调整尺寸后如何获得实际位置与大小。", "mustResolve": true },
          { "topic": "多设备视觉规格", "hint": "核对目标设备下的布局、Mini 态和可读性要求。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "闪控窗使用目标模板并保持在当前设备限制范围内，限制变化后重新适配且实际矩形可观察。", "criteriaTopics": ["模板选择与内容结构", "尺寸与宽高比限制", "限制变化监听", "实际矩形反馈", "多设备视觉规格"] }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": ["全部设备矩阵", "闪控球业务", "防窥保护"],
          "excludedCriterionTypes": ["version", "capability", "performance"],
          "includeExcludedTypeWhenPromptContains": {
            "version": ["API", "版本"],
            "capability": ["设备", "折叠屏", "平板", "PC"],
            "performance": ["性能", "布局耗时", "帧率"]
          }
        },
        "points": [
          {
            "id": "D02-01",
            "title": "模板尺寸与限制变化适配",
            "execution": "single_page",
            "criteriaTopics": ["模板选择与内容结构", "尺寸与宽高比限制", "限制变化监听", "实际矩形反馈"],
            "variants": [
              { "id": "minimum", "label": "判据允许的较小尺寸", "parameters": { "size": "criteria_minimum" } },
              { "id": "maximum", "label": "判据允许的较大尺寸", "parameters": { "size": "criteria_maximum" } }
            ]
          }
        ]
      },
      "implementation": { "steps": ["按目标内容选择单一模板。", "设置尺寸前查询当前限制。", "监听限制和实际矩形变化并更新布局，不写死设备像素。"] },
      "staticRules": [
        { "id": "float-view-template", "kind": "require_any", "patterns": ["FloatViewTemplateType\\.", "templateType\\s*:"], "onMissing": "failed", "message": "缺少闪控窗模板选择。" },
        { "id": "float-view-limits", "kind": "require_any", "patterns": ["getFloatViewLimits\\s*\\("], "onMissing": "failed", "message": "设置尺寸前未查询闪控窗限制。" },
        { "id": "float-view-size", "kind": "require_any", "patterns": ["setWindowSize\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗尺寸设置。" },
        { "id": "float-view-limit-listener", "kind": "require_any", "patterns": ["onLimitsChange\\s*\\(", "onRectChange\\s*\\("], "onMissing": "inconclusive", "message": "未发现动态限制或矩形监听；按目标适配范围确认。" }
      ],
      "negativeCases": ["忽略系统返回限制写死尺寸", "切换模板但不重核尺寸", "只看请求尺寸不看实际矩形", "所有设备强制同一布局密度"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"]
    },
    {
      "id": "FV-S003",
      "displayName": "闪控窗状态、可见性与主窗口恢复",
      "route": "float-view-api26",
      "intentPatterns": ["闪控窗状态监听", "onStateChange", "闪控窗可见性", "setFloatViewVisibilityInApp", "restoreMainWindow", "恢复主窗口", "闪控窗位置监听", "getWindowProperties"],
      "targets": ["FloatViewController"],
      "sources": ["float-view-guide", "float-view-api", "window-type-overview", "window-errors"],
      "criteriaSpec": {
        "required": [
          { "topic": "状态变化与停止原因", "hint": "核对状态枚举、停止原因和控制器失效时机。", "mustResolve": true },
          { "topic": "应用内可见性", "hint": "核对前后台和多任务状态下的可见性设置与默认行为。", "mustResolve": true },
          { "topic": "主窗口恢复", "hint": "核对恢复入口、Want 范围、交互或权限条件。", "mustResolve": true },
          { "topic": "属性与矩形观察", "hint": "核对窗口属性、位置尺寸和变化回调。", "mustResolve": true },
          { "topic": "监听注销", "hint": "核对停止、销毁或页面退出时的对称注销。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "闪控窗状态和实际矩形可被追踪，按目标控制应用内可见性并在允许条件下恢复主窗口，退出后无残留监听。", "criteriaTopics": ["状态变化与停止原因", "应用内可见性", "主窗口恢复", "属性与矩形观察", "监听注销"] }
      ],
      "implementation": { "steps": ["只注册目标需要的状态和矩形监听。", "按应用生命周期设置可见性。", "在允许的交互或权限条件下恢复本应用主窗口，并在控制器失效前注销监听。"] },
      "staticRules": [
        { "id": "float-view-state-listener", "kind": "require_any", "patterns": ["onStateChange\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗状态监听。" },
        { "id": "float-view-observation", "kind": "require_any", "patterns": ["onRectChange\\s*\\(", "getWindowProperties\\s*\\("], "onMissing": "inconclusive", "message": "未发现窗口矩形或属性观察。" },
        { "id": "float-view-listener-cleanup", "kind": "require_any", "patterns": ["offStateChange\\s*\\(", "offRectChange\\s*\\("], "onMissing": "failed", "message": "缺少闪控窗监听注销。" }
      ],
      "negativeCases": ["控制器销毁后继续调用", "注册匿名回调导致无法精确注销", "无用户交互或权限却恢复主窗口", "把请求位置当作实际位置"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime"]
    },
