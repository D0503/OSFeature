  "criteria": [
    {
      "id": "IL-F004",
      "type": "api",
      "topic": "API 契约（IL-F004）",
      "statement": "组件通过 systemMaterial 或组件专用材质入口接入沉浸材质。",
      "snapshotId": "enable",
      "anchor": "options参数中的systemMaterial字段设置",
      "status": "fresh"
    },
    {
      "id": "IL-F005",
      "type": "state",
      "topic": "状态语义（IL-F005）",
      "statement": "Material.empty 用于关闭组件材质，undefined 用于恢复组件默认材质策略。",
      "snapshotId": "enable",
      "anchor": "undefined表示恢复为组件默认的沉浸光感效果",
      "status": "fresh"
    },
    {
      "id": "IL-F009",
      "type": "navigation",
      "topic": "导航组件（IL-F009）",
      "statement": "Navigation 标题栏可通过 NavigationTitleOptions.systemMaterial 配置；默认材质受应用状态影响。",
      "snapshotId": "component",
      "anchor": "Navigation标题栏支持通过应用级开启",
      "status": "fresh"
    },
    {
      "id": "IL-F010",
      "type": "navigation",
      "topic": "导航组件（IL-F010）",
      "statement": "Tabs 使用 FloatingTabBarStyle.systemMaterial，且材质会被栏背景色或背景模糊覆盖。",
      "snapshotId": "component",
      "anchor": "三个条件需同时满足",
      "status": "fresh"
    },
    {
      "id": "IL-F011",
      "type": "navigation",
      "topic": "导航组件（IL-F011）",
      "statement": "AlphabetIndexer 弹窗材质与 popupBackground、popupBackgroundBlurStyle 存在互斥覆盖关系。",
      "snapshotId": "component",
      "anchor": "属性和沉浸光感能力互斥",
      "status": "fresh"
    },
    {
      "id": "IL-F012",
      "type": "overlay",
      "topic": "弹窗组件（IL-F012）",
      "statement": "Toast、Popup、Tips、Menu、Dialog 和 Sheet 具有各自的 systemMaterial 配置入口或默认材质策略。",
      "snapshotId": "component",
      "anchor": "弹窗类组件包括Toast、Popup、Tips、Menu和Dialog",
      "status": "fresh"
    },
    {
      "id": "IL-F013",
      "type": "overlay",
      "topic": "弹窗组件（IL-F013）",
      "statement": "弹窗普通背景色、背景模糊或大面积材质会覆盖效果或引入性能风险。",
      "snapshotId": "component",
      "anchor": "则不呈现沉浸光感效果",
      "status": "fresh"
    },
    {
      "id": "IL-F014",
      "type": "control",
      "topic": "控件组件（IL-F014）",
      "statement": "Button、Select、Toggle、Slider、ChipGroup 和 SegmentButton 系列提供组件或样式级材质入口。",
      "snapshotId": "component",
      "anchor": "按钮支持通过应用级开启",
      "status": "fresh"
    },
    {
      "id": "IL-F015",
      "type": "control",
      "topic": "控件组件（IL-F015）",
      "statement": "Select 按钮和下拉菜单是两个独立入口，分别使用 systemMaterial 与 menuSystemMaterial。",
      "snapshotId": "component",
      "anchor": "下拉按钮与下拉菜单的沉浸光感相互独立",
      "status": "fresh"
    },
    {
      "id": "IL-F016",
      "type": "control",
      "topic": "控件组件（IL-F016）",
      "statement": "Toggle 的 Checkbox 形态当前不适配沉浸材质，应保留普通样式。",
      "snapshotId": "component",
      "anchor": "当前未适配沉浸光感效果",
      "status": "fresh"
    },
    {
      "id": "IL-F017",
      "type": "material-option",
      "topic": "材质参数（IL-F017）",
      "statement": "materialColor 必须保留透明度；不透明颜色会遮挡材质滤镜效果。",
      "snapshotId": "common",
      "anchor": "会遮挡材质滤镜效果",
      "status": "fresh"
    },
    {
      "id": "IL-F018",
      "type": "material-option",
      "topic": "材质参数（IL-F018）",
      "statement": "colorInvert 只保证对资源颜色生效，硬编码颜色不能据此判定已反色。",
      "snapshotId": "faq",
      "anchor": "使用代码中硬编码的颜色值",
      "status": "fresh"
    },
    {
      "id": "IL-F019",
      "type": "material-option",
      "topic": "材质参数（IL-F019）",
      "statement": "interactive 与 lightEffect 控制交互和流光；Button 开启流光后需同时验证原按压和悬停反馈。",
      "snapshotId": "common",
      "anchor": "按压时产生弹性形变",
      "status": "fresh"
    },
    {
      "id": "IL-F020",
      "type": "material-option",
      "topic": "材质参数（IL-F020）",
      "statement": "applyShadow 与普通 shadow 属性存在顺序和所有权约束，避免重复阴影。",
      "snapshotId": "common",
      "anchor": "自定义的shadow设置不会生效",
      "status": "fresh"
    },
    {
      "id": "IL-F023",
      "type": "performance",
      "topic": "性能约束（IL-F023）",
      "statement": "应限制材质面积、嵌套、模糊叠加、动态背景、反色子树范围和重复阴影，并在真机测量性能与功耗。",
      "snapshotId": "constraints",
      "anchor": "沉浸光感效果作为一种",
      "status": "fresh"
    },
    {
      "id": "IL-F024",
      "type": "diagnostic",
      "topic": "诊断排障（IL-F024）",
      "statement": "无视觉效果时应排查普通背景覆盖、透明度、属性顺序、渲染区域、设备能力与算力档位。",
      "snapshotId": "faq",
      "anchor": "仍然呈现纯色背景或无任何材质表现",
      "status": "fresh"
    },
    {
      "id": "IL-F027",
      "type": "hds-version",
      "topic": "HDS 版本门槛（IL-F027）",
      "statement": "HDS 组件沉浸光感材质从 6.1.0(23) 起提供，仅支持 Stage 模型，系统能力为 SystemCapability.UIDesign.HDSComponent.Core。",
      "snapshotId": "hds-component-material-guide",
      "anchor": "新增支持HDS组件的沉浸光感材质能力",
      "status": "fresh"
    },
    {
      "id": "IL-F028",
      "type": "hds-navigation",
      "topic": "HdsNavigation（IL-F028）",
      "statement": "HdsNavigation 通过 TitleBarStyleOptions.systemMaterialEffect 为标题栏按钮设置沉浸光感，该字段从 6.1.0(23) 起提供。",
      "snapshotId": "hds-component-material-guide",
      "anchor": "可为标题栏按钮设置沉浸光感视效",
      "status": "fresh"
    },
    {
      "id": "IL-F029",
      "type": "hds-tabs",
      "topic": "HdsTabs（IL-F029）",
      "statement": "HdsTabs 通过 HdsTabsFloatingStyle.systemMaterialEffect 为底部悬浮页签设置沉浸光感，该字段从 6.1.0(23) 起提供。",
      "snapshotId": "hds-component-material-guide",
      "anchor": "可为底部页签设置沉浸光感视效",
      "status": "fresh"
    },
    {
      "id": "IL-F030",
      "type": "hds-material-params",
      "topic": "HDS 材质参数（IL-F030）",
      "statement": "HDS SystemMaterialParams 包含可选的 materialType 和 materialLevel；默认 materialType 为 NONE，默认 materialLevel 为 ADAPTIVE，因此省略 materialType 不能视为已经启用材质。",
      "snapshotId": "hds-navigation-api",
      "anchor": "默认值：hdsMaterial.MaterialType.NONE",
      "status": "fresh"
    },
    {
      "id": "IL-F031",
      "type": "hds-material-type",
      "topic": "HDS MaterialType（IL-F031）",
      "statement": "HDS MaterialType 取值为 NONE=0、ADAPTIVE=100、IMMERSIVE=101；ADAPTIVE 表示自适应系统材质且默认采用沉浸式材质。",
      "snapshotId": "hds-material-api",
      "anchor": "自适应系统材质。默认为沉浸式材质",
      "status": "fresh"
    },
    {
      "id": "IL-F032",
      "type": "hds-material-level",
      "topic": "HDS MaterialLevel（IL-F032）",
      "statement": "HDS MaterialLevel 取值为 EXQUISITE=0、GENTLE=1、SMOOTH=2、ADAPTIVE=10；ADAPTIVE 档由系统按设备算力自适应；设备不支持 IMMERSIVE 时官网建议使用 SMOOTH 以降低卡顿和发热风险。",
      "snapshotId": "hds-material-api",
      "anchor": "材质生效策略由系统策略决定",
      "status": "fresh"
    },
    {
      "id": "IL-F033",
      "type": "hds-adaptive-policy",
      "topic": "HDS 自适应策略（IL-F033）",
      "statement": "官网推荐 HDS 使用 materialType=ADAPTIVE、materialLevel=ADAPTIVE，让系统根据设备算力动态平衡材质效果和性能。",
      "snapshotId": "hds-component-material-guide",
      "anchor": "推荐使用系统自适应",
      "status": "fresh"
    },
    {
      "id": "IL-F034",
      "type": "hds-custom-policy",
      "topic": "HDS 自定义等级（IL-F034）",
      "statement": "HDS 自定义材质等级前应调用 getSystemMaterialTypes；支持 IMMERSIVE 时可选 EXQUISITE 或 GENTLE，不支持时建议使用 SMOOTH 以降低卡顿和发热风险。",
      "snapshotId": "hds-component-material-guide",
      "anchor": "再根据查询结果选用相应的材质效果枚举",
      "status": "fresh"
    },
    {
      "id": "IL-F035",
      "type": "hds-device",
      "topic": "HDS 设备差异（IL-F035）",
      "statement": "HDS 材质在 Phone、Tablet 可调用；PC/2in1 使用前需查询设备材质能力；HdsTabs 的该接口在 TV 无效果。",
      "snapshotId": "hds-navigation-api",
      "anchor": "在PC/2in1设备调用时需先调用",
      "status": "fresh"
    },
    {
      "id": "IL-F036",
      "type": "hds-code-example",
      "topic": "HDS 示例审计（IL-F036）",
      "statement": "HDS 官网指南示例是需补齐工程上下文的片段：示例导入仅含 @kit.UIDesignKit 与 @kit.ArkUI 的 SymbolGlyphModifier，示例本身不含异常处理代码；scenery01 明确要求替换为本地资源。",
      "snapshotId": "hds-component-material-guide",
      "anchor": "scenery为自定义资源，开发者需替换本地资源",
      "status": "fresh"
    },
    {
