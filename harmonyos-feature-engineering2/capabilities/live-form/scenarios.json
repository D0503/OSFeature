{
  "schemaVersion": "1.0",
  "featureId": "live-form",
  "displayName": "互动卡片",
  "defaultRoute": "live-form-stage",
  "routes": [
    {
      "id": "live-form-stage",
      "displayName": "ArkTS 互动卡片与服务卡片",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 20,
        "minTargetApi": 20,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "所有接口、配置字段和行为的起始版本以本次冻结官网为准；涉及后续版本新增字段时不得仅按能力基线推断。"
      },
      "sdk": {
        "preferredApi": 20,
        "validatedLocalVersion": null,
        "requiredDeclarationGlobs": [
          "openharmony/ets/api/@ohos.app.form.formProvider.d.ts",
          "openharmony/ets/api/@ohos.app.form.formInfo.d.ts",
          "openharmony/ets/api/@ohos.app.form.LiveFormExtensionAbility.d.ts",
          "openharmony/ets/api/application/LiveFormExtensionContext.d.ts"
        ],
        "requiredSymbols": [
          "requestOverflow",
          "cancelOverflow",
          "getFormRect",
          "OverflowInfo",
          "onLiveFormCreate",
          "onLiveFormDestroy",
          "startAbilityByLiveForm"
        ]
      },
      "supportedTargets": {
        "extensions": ["FormExtensionAbility", "LiveFormExtensionAbility"],
        "configuration": ["form_config.json", "module.json5"],
        "runtime": ["formProvider", "LiveFormExtensionContext"]
      },
      "intentPatterns": ["互动卡片", "LiveForm", "场景动效卡片", "服务卡片"]
    }
  ],
  "projectSignals": [
    { "id": "live-form-extension", "extensions": [".ets", ".ts"], "pattern": "LiveFormExtensionAbility|onLiveFormCreate|onLiveFormDestroy" },
    { "id": "live-form-scene-config", "extensions": [".json", ".json5"], "pattern": "sceneAnimationParams|funInteractionParams" },
    { "id": "live-form-overflow", "extensions": [".ets", ".ts"], "pattern": "requestOverflow\\s*\\(|cancelOverflow\\s*\\(|getFormRect\\s*\\(" },
    { "id": "service-form", "extensions": [".ets", ".ts", ".json", ".json5"], "pattern": "FormExtensionAbility|postCardAction|ohos.extension.form" }
  ],
  "safety": {
    "modifyMinimumScope": true,
    "preserveDirtyFiles": true,
    "keepFailedChanges": true,
    "automaticRollback": false,
    "automaticSdkUpgrade": false,
    "automaticEmulatorDownload": false,
    "automaticUninstall": false,
    "maxDirectedRepairRounds": 2
  },
  "verification": {
    "layerStatuses": ["passed", "failed", "blocked", "not_run", "inconclusive"],
    "verdicts": ["passed", "passed_with_spec_conflict", "build_passed_runtime_pending", "inconclusive", "failed", "blocked"],
    "visualSuccessRequiresObservation": true,
    "buildCommand": "devecocli build",
    "runCommand": "devecocli run",
    "devicePolicy": "run-only-when-requested-and-exactly-one-device-selected"
  },
  "entryPoints": [
    { "snapshotId": "live-form-practice", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/best-practices/bpta-live-form-development-practice", "title": "互动卡片开发实践" },
    { "snapshotId": "live-form-overview", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-ui-liveform-overview", "title": "互动卡片概述" },
    { "snapshotId": "scene-animation-guide", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-ui-liveform-sceneanimation-development", "title": "场景动效类型互动卡片开发指导" },
    { "snapshotId": "fun-interaction-guide", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-ui-liveform-funinteraction-development", "title": "趣味交互类型互动卡片开发指导" },
    { "snapshotId": "widget-config", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-ui-widget-configuration", "title": "配置 ArkTS 卡片的配置文件" },
    { "snapshotId": "module-config", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/module-configuration-file", "title": "module.json5 配置文件" },
    { "snapshotId": "live-form-ability", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-app-form-liveformextensionability", "title": "LiveFormExtensionAbility" },
    { "snapshotId": "live-form-context", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-application-liveformextensioncontext", "title": "LiveFormExtensionContext" },
    { "snapshotId": "form-provider", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-app-form-formprovider", "title": "formProvider" },
    { "snapshotId": "form-info", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-app-form-forminfo", "title": "formInfo" },
    { "snapshotId": "form-extension", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-app-form-formextensionability", "title": "FormExtensionAbility" },
    { "snapshotId": "form-binding-data", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-app-form-formbindingdata", "title": "formBindingData" },
    { "snapshotId": "ui-extension-session", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-app-ability-uiextensioncontentsession", "title": "UIExtensionContentSession" },
    { "snapshotId": "local-storage", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-localstorage", "title": "LocalStorage" },
    { "snapshotId": "form-refresh-data", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/form-refresh-and-data-interaction", "title": "卡片更新与数据交互" },
    { "snapshotId": "widget-events", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-ui-widget-event-overview", "title": "ArkTS 卡片页面交互概述" },
    { "snapshotId": "music-service-form", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-guides/arkts-ui-music-service-form", "title": "音乐服务卡片" },
    { "snapshotId": "service-widget-design", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/design-guides/system-features-service-widget-0000002087671904", "title": "服务卡片设计指南" },
    { "snapshotId": "thermal-api", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-thermal", "title": "热管理" },
    { "snapshotId": "universal-errors", "officialUrl": "https://developer.huawei.com/consumer/cn/doc/harmonyos-references/errorcode-universal", "title": "通用错误码" }
  ],
  "scenarios": [
    {
      "id": "LF-S001",
      "displayName": "场景动效互动卡片基础接入",
      "route": "live-form-stage",
      "intentPatterns": ["接入互动卡片", "创建互动卡片", "场景动效类型", "sceneAnimationParams", "互动卡片配置", "LiveForm扩展"],
      "intentGroups": [["互动卡片", "基础接入"], ["互动卡片", "配置"]],
      "targets": ["LiveFormExtensionAbility"],
      "sources": ["live-form-overview", "scene-animation-guide", "widget-config", "module-config", "live-form-ability"],
      "criteriaSpec": {
        "required": [
          { "topic": "场景类型与能力边界", "hint": "核对场景动效类型与趣味交互类型的选择条件及业务降级要求。", "mustResolve": true },
          { "topic": "扩展能力声明", "hint": "核对模块中的扩展能力类型、入口和必要元信息。", "mustResolve": true },
          { "topic": "卡片配置关联", "hint": "核对普通卡片配置与场景动效配置的名称关联和字段版本。", "mustResolve": true },
          { "topic": "激活态与非激活态分工", "hint": "核对两个状态的 UI 承载者和切换职责。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "目标卡片可按配置进入场景动效激活态，并在动效结束或取消后恢复非激活态。", "criteriaTopics": ["场景类型与能力边界", "扩展能力声明", "卡片配置关联", "激活态与非激活态分工"] }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": ["未点名的触发方式", "功耗专项", "音乐业务"],
          "excludedCriterionTypes": ["version", "capability", "performance"],
          "includeExcludedTypeWhenPromptContains": {
            "version": ["API", "SDK", "版本", "兼容"],
            "capability": ["设备", "机型", "桌面", "支持范围"],
            "performance": ["性能", "功耗", "热档位"]
          }
        },
        "points": [
          {
            "id": "D01-01",
            "title": "激活态与非激活态切换",
            "execution": "single_page",
            "criteriaTopics": ["卡片配置关联", "激活态与非激活态分工"],
            "demoSetupRequirements": [
              { "id": "installed-desktop-form", "description": "安装应用并把目标卡片添加到可观察的系统位置。", "enforcement": "implementation_and_static_gate", "countsAsFeatureValidation": false }
            ],
            "variants": [
              { "id": "inactive", "label": "非激活态基线", "parameters": { "state": "inactive" } },
              { "id": "active", "label": "场景动效激活态", "parameters": { "state": "active" } }
            ]
          }
        ]
      },
      "implementation": { "steps": ["保留普通卡片非激活态实现。", "新增与卡片配置一致的 LiveForm 扩展声明和激活态页面。", "只实现用户点名的动效和触发入口。"] },
      "staticRules": [
        { "id": "live-form-extension", "kind": "require_any", "patterns": ["LiveFormExtensionAbility", "type\\s*:\\s*['\"]liveForm['\"]"], "onMissing": "failed", "message": "缺少 LiveForm 扩展能力实现或声明。" },
        { "id": "scene-animation-config", "kind": "require_any", "patterns": ["sceneAnimationParams"], "onMissing": "failed", "message": "缺少场景动效类型卡片配置。" }
      ],
      "negativeCases": ["把趣味交互快游戏按 ArkTS 场景动效实现", "只实现激活态而缺少普通卡片非激活态", "扩展名称与卡片配置不一致"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"]
    },
    {
      "id": "LF-S002",
      "displayName": "激活态生命周期与 UI 数据绑定",
      "route": "live-form-stage",
      "intentPatterns": ["onLiveFormCreate", "onLiveFormDestroy", "loadContent", "激活态页面", "互动卡片生命周期", "互动卡片资源清理", "互动卡片数据绑定"],
      "targets": ["LiveFormExtensionAbility", "UIExtensionContentSession", "LocalStorage"],
      "sources": ["scene-animation-guide", "live-form-ability", "ui-extension-session", "local-storage", "form-binding-data"],
      "criteriaSpec": {
        "required": [
          { "topic": "创建回调与页面加载", "hint": "核对创建回调参数、激活态页面加载和初始化时机。", "mustResolve": true },
          { "topic": "跨页面状态传递", "hint": "核对激活态页面可用的数据传递与状态读取方式。", "mustResolve": true },
          { "topic": "销毁回调与资源释放", "hint": "核对退出激活态后的资源、监听和任务清理。", "mustResolve": true },
          { "topic": "受限模块与运行上下文", "hint": "核对 LiveForm 扩展上下文可用能力和引用限制。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "激活态创建时加载目标 UI 并完成数据初始化，销毁时释放本轮创建的资源。", "criteriaTopics": ["创建回调与页面加载", "跨页面状态传递", "销毁回调与资源释放", "受限模块与运行上下文"] }
      ],
      "implementation": { "steps": ["在创建回调内建立本轮激活态所需状态并加载页面。", "页面只读取明确传入的共享状态。", "在销毁回调中对称释放监听、定时器和业务资源。"] },
      "staticRules": [
        { "id": "live-form-create", "kind": "require_any", "patterns": ["onLiveFormCreate\\s*\\("], "onMissing": "failed", "message": "缺少 onLiveFormCreate 生命周期实现。" },
        { "id": "live-form-load-content", "kind": "require_any", "patterns": ["loadContent\\s*\\("], "onMissing": "failed", "message": "创建回调未加载激活态页面。" },
        { "id": "live-form-destroy", "kind": "require_any", "patterns": ["onLiveFormDestroy\\s*\\("], "onMissing": "inconclusive", "message": "未发现销毁回调；需根据资源占用判据确认是否必须实现。" }
      ],
      "negativeCases": ["在扩展销毁后继续持有会话资源", "用普通卡片上下文替代激活态上下文", "创建资源但无对应清理"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime"]
    },
    {
      "id": "LF-S003",
      "displayName": "破框动效区域申请与取消",
      "route": "live-form-stage",
      "intentPatterns": ["破框动效", "requestOverflow", "cancelOverflow", "getFormRect", "动效区域", "OverflowInfo", "取消互动卡片动效"],
      "targets": ["formProvider"],
      "sources": ["scene-animation-guide", "live-form-practice", "form-provider", "form-info", "universal-errors"],
      "criteriaSpec": {
        "required": [
          { "topic": "卡片位置与尺寸获取", "hint": "核对请求前获取目标卡片矩形信息的接口、坐标和异常处理。", "mustResolve": true },
          { "topic": "动效申请区域", "hint": "核对申请区域与卡片区域、系统允许区域之间的几何约束。", "mustResolve": true },
          { "topic": "动效时长与切换参数", "hint": "核对持续时间和系统默认切换动效参数。", "mustResolve": true },
          { "topic": "取消与状态恢复", "hint": "核对主动取消接口、调用条件和非激活态恢复结果。", "mustResolve": true },
          { "topic": "请求失败处理", "hint": "核对设备不支持、配置错误和卡片标识异常等失败路径。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "目标卡片在合法区域内显示破框动效，取消或到期后恢复非激活态，失败路径保留可诊断错误。", "criteriaTopics": ["卡片位置与尺寸获取", "动效申请区域", "动效时长与切换参数", "取消与状态恢复", "请求失败处理"] }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": ["全部卡片尺寸矩阵", "定时刷新", "音乐业务"],
          "excludedCriterionTypes": ["version", "capability", "performance"],
          "includeExcludedTypeWhenPromptContains": {
            "version": ["API", "版本"],
            "capability": ["设备", "机型", "尺寸", "桌面"],
            "performance": ["功耗", "性能", "热档位"]
          }
        },
        "points": [
          {
            "id": "D03-01",
            "title": "破框区域与取消恢复",
            "execution": "single_page",
            "criteriaTopics": ["动效申请区域", "动效时长与切换参数", "取消与状态恢复"],
            "interactionRequirements": [
              { "id": "trigger-overflow", "description": "从用户点名的入口发起破框动效。", "expected": "合法请求进入激活态并显示本次判据允许的破框区域。" },
              { "id": "cancel-overflow", "description": "在动效执行期间触发取消。", "expected": "动效停止并恢复到本次判据定义的非激活态。" }
            ],
            "variants": [
              { "id": "inside-card", "label": "卡片区域基线", "parameters": { "overflow": "none" } },
              { "id": "valid-overflow", "label": "合法破框区域", "parameters": { "overflow": "criteria_derived" } }
            ]
          }
        ]
      },
      "implementation": { "steps": ["用目标卡片真实标识查询矩形信息。", "按本次判据计算并校验请求区域和持续时间。", "分别处理申请、取消和错误返回。"] },
      "staticRules": [
        { "id": "overflow-request", "kind": "require_any", "patterns": ["requestOverflow\\s*\\("], "onMissing": "failed", "message": "缺少破框动效申请。" },
        { "id": "form-rect-query", "kind": "require_any", "patterns": ["getFormRect\\s*\\("], "onMissing": "inconclusive", "message": "未发现卡片矩形查询；需核对区域是否来自可靠运行时数据。" },
        { "id": "overflow-cancel", "kind": "require_any", "patterns": ["cancelOverflow\\s*\\("], "onMissing": "inconclusive", "message": "未发现取消入口；仅在目标要求取消时判失败。" }
      ],
      "negativeCases": ["使用固定设备坐标代替目标卡片矩形", "请求区域未覆盖卡片自身区域", "忽略 Promise 拒绝和同步异常", "取消后仍保持激活态资源"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"]
    },
    {
      "id": "LF-S004",
      "displayName": "动效触发策略与运行约束",
      "route": "live-form-stage",
      "intentPatterns": ["点击触发动效", "定时触发动效", "定点触发动效", "摇一摇触发", "triggerTypes", "省电模式互动卡片", "热档位互动卡片", "互动卡片触发次数", "设备不支持互动卡片"],
      "intentGroups": [["互动卡片", "触发方式"], ["互动卡片", "热档位"]],
      "intentPriority": 2,
      "targets": ["formProvider", "thermal"],
      "sources": ["scene-animation-guide", "live-form-practice", "widget-config", "form-refresh-data", "form-provider", "thermal-api", "universal-errors"],
      "criteriaSpec": {
        "required": [
          { "topic": "触发来源与调用链", "hint": "核对点击、刷新、传感器等用户点名触发方式对应的调用位置和前置条件。", "mustResolve": true },
          { "topic": "配置字段与版本", "hint": "核对触发配置字段、取值和起始版本。", "mustResolve": true },
          { "topic": "频次与并发策略", "hint": "核对单卡片触发频次、全局竞争和用户主动触发优先级。", "mustResolve": true },
          { "topic": "功耗与热状态限制", "hint": "核对省电模式和不同热档位下的响应策略。", "mustResolve": true },
          { "topic": "设备能力与降级", "hint": "核对支持位置、机型范围、错误码和普通卡片降级。", "mustResolve": true }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        { "assertion": "目标触发方式在满足运行约束时发起动效，不满足设备、功耗或竞争条件时安全降级并保留错误证据。", "criteriaTopics": ["触发来源与调用链", "配置字段与版本", "频次与并发策略", "功耗与热状态限制", "设备能力与降级"] }
      ],
      "implementation": { "steps": ["只接入用户点名的触发来源。", "触发前核对必要状态并为请求失败提供降级路径。", "不通过高频重试规避系统频次、功耗或并发限制。"] },
      "staticRules": [
        { "id": "triggered-overflow", "kind": "require_any", "patterns": ["requestOverflow\\s*\\("], "onMissing": "failed", "message": "未发现触发动效请求。" },
        { "id": "shake-config", "kind": "require_any", "patterns": ["triggerTypes", "shake"], "onMissing": "inconclusive", "message": "未发现摇一摇配置；仅在目标要求摇一摇时判失败。" },
        { "id": "request-error-handling", "kind": "require_any", "patterns": ["catch\\s*\\(", "\\.catch\\s*\\("], "onMissing": "failed", "message": "动效请求缺少失败处理。" }
      ],
      "negativeCases": ["把系统拒绝当作成功", "后台循环重试动效请求", "未点名却同时接入多种触发方式", "设备不支持时移除普通卡片能力"],
      "requiredChecks": ["static", "sdk", "build", "install", "runtime", "visual"]
    },
    {
      "id": "LF-S005",
      "displayName": "互动卡片点击跳转应用页面",
      "route": "live-form-stage",
      "intentPatterns": ["startAbilityByLiveForm", "互动卡片跳转", "激活态跳转", "点击进入应用", "互动卡片拉起页面", "显式Want"],
      "intentPriority": 2,
      "targets": ["LiveFormExtensionContext"],
      "sources": ["live-form-context", "live-form-ability", "scene-animation-guide"],
