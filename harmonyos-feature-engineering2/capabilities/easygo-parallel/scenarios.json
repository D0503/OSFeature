{
  "schemaVersion": "1.0",
  "featureId": "easygo-parallel",
  "displayName": "平行视界",
  "defaultRoute": "easygo-api23",
  "routes": [
    {
      "id": "easygo-api23",
      "displayName": "EasyGo 平行视界基础配置（API 23）",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 23,
        "minTargetApi": 23,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "按本次冻结官网核对配置项起始版本；不得因基础能力从 API 23 支持而擅自提高工程 compatibleSdkVersion。"
      },
      "sdk": {
        "preferredApi": 23,
        "validatedLocalVersion": "26.0.0.105",
        "requiredDeclarationGlobs": [
          "openharmony/ets/api/@ohos.arkui.UIContext.d.ts"
        ],
        "requiredSymbols": []
      },
      "supportedTargets": {
        "routing": [
          "Navigation",
          "NavDestination"
        ],
        "configuration": [
          "easyGo"
        ]
      },
      "intentPatterns": [
        "API 23",
        "基础平行视界"
      ]
    },
    {
      "id": "easygo-api24-runtime",
      "displayName": "EasyGo 平行视界运行态查询（API 24）",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 24,
        "minTargetApi": 24,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "isEasySplit 的实际版本与调用条件以本次冻结 UIContext 文档为准。"
      },
      "sdk": {
        "preferredApi": 24,
        "validatedLocalVersion": null,
        "requiredDeclarationGlobs": [
          "openharmony/ets/api/@ohos.arkui.UIContext.d.ts"
        ],
        "requiredSymbols": [
          "isEasySplit"
        ]
      },
      "supportedTargets": {
        "runtime": [
          "UIContext"
        ]
      },
      "intentPatterns": [
        "isEasySplit",
        "运行态查询",
        "是否处于平行视界"
      ]
    },
    {
      "id": "easygo-api26",
      "displayName": "EasyGo 平行视界增强配置（API 26）",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 26,
        "minTargetApi": 26,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "pagePairs、wideSplit、squareSplit、splitDividerColor、drawableRectHook、enableInSplitScreen 等增强字段须按本次冻结官网核对版本。"
      },
      "sdk": {
        "preferredApi": 26,
        "validatedLocalVersion": null,
        "requiredDeclarationGlobs": [
          "openharmony/ets/api/@ohos.window.d.ts"
        ],
        "requiredSymbols": []
      },
      "supportedTargets": {
        "routing": [
          "Navigation",
          "NavDestination"
        ],
        "configuration": [
          "easyGo"
        ],
        "runtime": [
          "UIContext"
        ]
      },
      "intentPatterns": [
        "API 26",
        "增强平行视界"
      ]
    }
  ],
  "projectSignals": [
    {
      "id": "easygo-module-entry",
      "extensions": [
        ".json5"
      ],
      "pattern": "\\beasyGo\\s*:"
    },
    {
      "id": "easygo-profile",
      "extensions": [
        ".json",
        ".json5"
      ],
      "pattern": "displayModeOptions|navigationSplitOptions|routerSplitOptions"
    },
    {
      "id": "easygo-navigation",
      "extensions": [
        ".ets",
        ".ts"
      ],
      "pattern": "\\bNavigation\\s*\\(|\\bNavDestination\\s*\\("
    },
    {
      "id": "easygo-runtime",
      "route": "easygo-api24-runtime",
      "extensions": [
        ".ets",
        ".ts"
      ],
      "pattern": "isEasySplit\\s*\\("
    }
  ],
  "safety": {
    "modifyMinimumScope": true,
    "preserveDirtyFiles": true,
    "keepFailedChanges": true,
    "automaticRollback": false,
    "automaticSdkUpgrade": false,
    "automaticEmulatorDownload": false,
    "automaticUninstall": false,
    "maxDirectedRepairRounds": 2
  },
  "verification": {
    "layerStatuses": [
      "passed",
      "failed",
      "blocked",
      "not_run",
      "inconclusive"
    ],
    "verdicts": [
      "passed",
      "passed_with_spec_conflict",
      "build_passed_runtime_pending",
      "inconclusive",
      "failed",
      "blocked"
    ],
    "visualSuccessRequiresObservation": true,
    "buildCommand": "devecocli build",
    "runCommand": "devecocli run",
    "devicePolicy": "run-only-when-requested-and-exactly-one-device-selected"
  },
  "entryPoints": [
