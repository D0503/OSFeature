  "scenarios": [
    {
      "id": "EP-S001",
      "displayName": "平行视界基础接入与路由框架选择",
      "route": "easygo-api23",
      "intentPatterns": [
        "接入平行视界",
        "开启平行视界",
        "easy_go.json",
        "easyGo",
        "navigationSplit",
        "routerSplit",
        "Navigation分栏",
        "Router分栏"
      ],
      "targets": [
        "Navigation"
      ],
      "sources": [
        "easygo-guide",
        "module-config",
        "navigation-routing",
        "parallel-design"
      ],
      "criteriaSpec": {
        "required": [
          {
            "topic": "entry 模块配置入口",
            "hint": "核对 easyGo 对 profile 配置的引用位置、作用域和文件结构。",
            "mustResolve": true
          },
          {
            "topic": "设备与显示模式",
            "hint": "核对 common/phone/tablet、wideWindowMode/squareWindowMode 及 original/navigationSplit/routerSplit。",
            "mustResolve": true
          },
          {
            "topic": "路由框架一致性",
            "hint": "按工程实际路由框架选择对应 splitOptions，并核对混用限制。",
            "mustResolve": true
          }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        {
          "assertion": "目标宽屏窗口按所选路由框架进入平行视界，窄屏与关闭模式保持原布局。",
          "criteriaTopics": [
            "entry 模块配置入口",
            "设备与显示模式",
            "路由框架一致性"
          ]
        }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": [
            "未点名的设备矩阵",
            "未点名的高级配置",
            "性能专项"
          ],
          "excludedCriterionTypes": [
            "version",
            "capability",
            "performance"
          ],
          "includeExcludedTypeWhenPromptContains": {
            "version": [
              "API",
              "SDK",
              "版本",
              "兼容"
            ],
            "capability": [
              "设备",
              "窗口形态",
              "折叠屏",
              "平板"
            ],
            "performance": [
              "性能",
              "功耗",
              "帧率"
            ]
          }
        },
        "points": [
          {
            "id": "D01-01",
            "title": "基础平行视界分栏效果",
            "execution": "rebuild_per_variant",
            "criteriaTopics": [
              "设备与显示模式",
              "路由框架一致性"
            ],
            "demoSetupRequirements": [
              {
                "id": "two-routable-pages",
                "description": "提供可从主页进入详情页的最小路由与稳定测试数据。",
                "enforcement": "implementation_and_static_gate",
                "countsAsFeatureValidation": false
              }
            ],
            "variants": [
              {
                "id": "parallel-enabled",
                "label": "所选路由框架分栏",
                "parameters": {
                  "wideWindowMode": "match_project_router",
                  "splitOptions": "match_project_router"
                }
              },
              {
                "id": "parallel-original",
                "label": "original 基线",
                "parameters": {
                  "wideWindowMode": "original"
                }
              }
            ]
          }
        ]
      },
      "implementation": {
        "steps": [
          "只在 entry 模块登记 easyGo profile。",
          "按工程真实路由框架配置 navigationSplitOptions 或 routerSplitOptions，不同时配置两者。",
          "Demo 可参考输入工程的通用 Navigation 路由结构，但只保留目标场景需要的页面与交互。"
        ]
      },
      "staticRules": [
        {
          "id": "easygo-entry",
          "kind": "require_any",
          "patterns": [
            "['\"]?easyGo['\"]?\\s*:\\s*['\"]\\$profile:"
          ],
          "onMissing": "failed",
          "message": "entry module.json5 缺少 easyGo profile 引用。"
        },
        {
          "id": "easygo-display-mode",
          "kind": "require_any",
          "patterns": [
            "displayModeOptions"
          ],
          "onMissing": "failed",
          "message": "缺少平行视界显示模式配置。"
        },
        {
          "id": "easygo-options",
          "kind": "require_any",
          "patterns": [
            "navigationSplitOptions",
            "routerSplitOptions"
          ],
          "onMissing": "failed",
          "message": "缺少与路由框架匹配的 splitOptions。"
        }
      ],
      "negativeCases": [
        "非 entry 模块配置",
        "Navigation 与 Router 配置混用",
        "缺少 profile 资源",
        "窄屏或不满足窗口条件"
      ],
      "requiredChecks": [
        "static",
        "sdk",
        "build",
        "install",
        "runtime",
        "visual"
      ]
    },
    {
      "id": "EP-S002",
      "displayName": "主页与关联页分栏",
      "route": "easygo-api23",
      "intentPatterns": [
        "主页与关联页",
        "配置主页",
        "关联页",
        "homePage",
        "relatedPage",
        "主页固定"
      ],
      "targets": [
        "Navigation",
        "NavDestination"
      ],
      "sources": [
        "easygo-guide",
        "navigation-api",
        "navdestination-api"
      ],
      "criteriaSpec": {
        "required": [
          {
            "topic": "主页标识",
            "hint": "按 Navigation 或 Router 的页面标识格式核对 homePage。",
            "mustResolve": true
          },
          {
            "topic": "关联页约束",
            "hint": "核对 relatedPage 的前置条件、格式与参数限制。",
            "mustResolve": true
          },
          {
            "topic": "首次分栏结果",
            "hint": "核对同时配置与只配置主页时的页面组合。",
            "mustResolve": true
          }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        {
          "assertion": "应用进入目标路由后，主页与关联页按本次配置显示，后续目标页面在正确分栏更新。",
          "criteriaTopics": [
            "主页标识",
            "关联页约束",
            "首次分栏结果"
          ]
        }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": [
            "路由模式对比",
            "全屏与分屏专项"
          ],
          "excludedCriterionTypes": [
            "version",
            "capability",
            "performance"
          ],
          "includeExcludedTypeWhenPromptContains": {
            "version": [
              "API",
              "版本"
            ],
            "capability": [
              "设备",
              "窗口"
            ],
            "performance": [
              "性能",
              "功耗"
            ]
          }
        },
        "points": [
          {
            "id": "D02-01",
            "title": "主页与关联页初始分栏效果",
            "execution": "rebuild_per_variant",
            "criteriaTopics": [
              "主页标识",
              "关联页约束",
              "首次分栏结果"
            ],
            "variants": [
              {
                "id": "home-related",
                "label": "同时配置主页与关联页",
                "parameters": {
                  "homePage": "configured",
                  "relatedPage": "configured"
                }
              },
              {
                "id": "home-only",
                "label": "只配置主页",
                "parameters": {
                  "homePage": "configured",
                  "relatedPage": "omitted"
                }
              }
            ]
          }
        ]
      },
      "implementation": {
        "steps": [
          "从实际路由结构确定主页标识。",
          "仅在需求包含关联页时配置 relatedPage，并使用稳定静态页面。"
        ]
      },
      "staticRules": [
        {
          "id": "home-page",
          "kind": "require_any",
          "patterns": [
            "\"homePage\"\\s*:"
          ],
          "onMissing": "failed",
          "message": "未发现 homePage 配置。"
        },
        {
          "id": "related-page",
          "kind": "require_any",
          "patterns": [
            "\"relatedPage\"\\s*:"
          ],
          "onMissing": "inconclusive",
          "message": "未发现 relatedPage；若目标要求关联页则失败。"
        }
      ],
      "negativeCases": [
        "relatedPage 缺少 homePage",
        "页面名格式与路由框架不一致",
        "关联页依赖动态参数"
      ],
      "requiredChecks": [
        "static",
        "sdk",
        "build",
        "install",
        "runtime",
        "visual"
      ]
    },
    {
      "id": "EP-S005",
      "displayName": "路由全屏页与恢复分栏",
      "route": "easygo-api23",
      "intentPatterns": [
        "全屏页",
        "fullScreenPages",
        "路由全屏",
        "退出分栏",
        "恢复分栏",
        "全屏图片"
      ],
      "targets": [
        "NavDestination"
      ],
      "sources": [
        "easygo-guide",
        "navdestination-api"
      ],
      "criteriaSpec": {
        "required": [
          {
            "topic": "全屏页配置",
            "hint": "核对 fullScreenPages 的页面格式、默认值和互斥集合。",
            "mustResolve": true
          },
          {
            "topic": "进入与退出全屏",
            "hint": "核对目标页面显示和隐藏时分栏状态变化。",
            "mustResolve": true
          }
        ],
        "conflictProbes": []
      },
      "expectedOutcomeTemplates": [
        {
          "assertion": "进入配置页时退出分栏并全屏显示，返回后恢复原平行视界分栏与路由状态。",
          "criteriaTopics": [
            "全屏页配置",
            "进入与退出全屏"
          ]
        }
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "scopePolicy": {
          "selection": "prompt_strong_relevance_only",
          "prerequisiteHandling": "setup_or_static_only",
          "excludedByDefault": [
            "横屏与分屏专项"
          ],
          "excludedCriterionTypes": [
            "version",
            "capability",
            "performance"
          ],
          "includeExcludedTypeWhenPromptContains": {
            "version": [
              "API",
              "版本"
            ],
            "capability": [
              "设备",
              "窗口"
            ],
            "performance": [
              "性能",
              "功耗"
            ]
          }
        },
        "points": [
          {
            "id": "D05-01",
            "title": "全屏页进入 / 返回恢复效果",
            "execution": "single_page",
            "criteriaTopics": [
              "进入与退出全屏"
            ],
            "interactionRequirements": [
              {
                "id": "open-fullscreen",
                "description": "从分栏详情页进入配置的全屏页。",
                "expected": "目标页全屏显示。"
              },
              {
                "id": "back-to-split",
                "description": "从全屏页返回。",
                "expected": "恢复进入前的平行视界分栏。"
              }
            ],
            "variants": [
              {
                "id": "configured-fullscreen-page",
                "label": "fullScreenPages 目标页",
                "parameters": {
                  "fullScreenPages": [
                    "FullScreenImagePage"
                  ]
                }
              }
            ]
          }
        ]
      },
      "implementation": {
        "steps": [
          "参考输入工程的全屏图片页面交互骨架，仅复用本场景所需结构。",
          "保持进入前分栏状态可复现，验证进入与返回两个时刻。"
        ]
      },
      "staticRules": [
        {
          "id": "fullscreen-pages",
          "kind": "require_any",
          "patterns": [
            "\"fullScreenPages\"\\s*:"
          ],
          "onMissing": "failed",
          "message": "未发现 fullScreenPages 配置。"
        }
      ],
      "negativeCases": [
        "目标页同时配置为主页或关联页",
        "只截图全屏不验证返回恢复",
        "用普通窗口全屏替代配置效果"
      ],
      "requiredChecks": [
        "static",
        "sdk",
        "build",
        "install",
        "runtime",
        "visual"
      ]
    },
    {
      "id": "EP-S006",
      "displayName": "主动横屏时全屏策略",
      "route": "easygo-api23",
      "intentPatterns": [
        "横屏全屏",
        "请求横屏",
        "supportLandscapeFullscreen",
        "横屏保持分栏",
        "页面方向"
      ],
      "targets": [
        "NavDestination"
      ],
      "sources": [
        "easygo-guide",
        "window-api",
        "window-enums",
        "navdestination-api"
      ],
      "criteriaSpec": {
        "required": [
          {
            "topic": "横屏全屏开关",
            "hint": "核对 supportLandscapeFullscreen 默认值及 true/false 行为。",
            "mustResolve": true
          },
          {
            "topic": "窗口级方向请求",
            "hint": "核对平行视界下页面级与窗口级方向策略。",
            "mustResolve": true
          },
          {
            "topic": "方向恢复",
            "hint": "核对退出目标页后的方向与分栏恢复。",
            "mustResolve": true
          }
        ],
        "conflictProbes": []
      },
